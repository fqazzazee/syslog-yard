[Unit]
Description=syslog-bucket — syslog triage UI
Requires=bucket-db.service
After=bucket-db.service

[Container]
# Built locally with podman (see this dir's README); no registry is used.
Image=localhost/syslog-bucket:latest
ContainerName=syslog-bucket
Network=yard.network
Network=bucket-db.network
# Prefix with 127.0.0.1: to publish on loopback only (single-host lab).
PublishPort=8082:8080
# The password must match POSTGRES_PASSWORD in bucket-db.container.
Environment=BUCKET_DB_URL=postgres://syslog_bucket:syslog_bucket@bucket-db:5432/syslog_bucket?sslmode=disable
Environment=BUCKET_API_ADDR=:8080
Environment=BUCKET_INGEST_ADDR=:6601
Environment=YARD_LINK_HOSE=8080
Environment=YARD_LINK_VALVE=8081
Environment=YARD_LINK_BUCKET=8082
# Initial admin password, first start only. Commented out so a random one is
# generated and printed once (find it: journalctl --user -u syslog-bucket |
# grep -i password). Uncomment to pin a known password instead.
# Environment=BUCKET_ADMIN_PASSWORD=change-me
# Optional OIDC sign-in — see deploy/compose.yaml for the full list.
# Environment=BUCKET_OIDC_ISSUER=https://idp.example.com/realms/yard
# Environment=BUCKET_OIDC_CLIENT_ID=syslog-bucket
# Environment=BUCKET_OIDC_CLIENT_SECRET=…
# Environment=BUCKET_OIDC_REDIRECT_URL=http://localhost:8082/api/auth/oidc/callback
# Believe X-Forwarded-For from the hose/valve (they proxy logins), so the
# login throttle sees each browser's address instead of one shared budget
# per tool. Name them: never the yard network's subnet, because a client
# reaching a published port can appear from it and forge the header. Add a
# reverse proxy's address here if one sits in front; see docs/SECURITY.md.
Environment=YARD_TRUSTED_PROXIES=syslog-hose,syslog-valve
# Non-root image on unprivileged ports: no capabilities needed.
DropCapability=all
NoNewPrivileges=true
# /api/healthz also pings Postgres. Notify=healthy holds dependents
# (bucket-syslog) until the bucket answers.
HealthCmd=wget -q -T 3 -O /dev/null http://127.0.0.1:8080/api/healthz
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy
# Shutdown drains the ingest queue into Postgres (up to 6 s) and then
# queued notifications (up to 3 s more); podman's 10 s default would cut
# that close. (PodmanArgs rather than StopTimeout= keeps podman 4.6 happy.)
PodmanArgs=--stop-timeout=30

[Service]
Restart=always

[Install]
WantedBy=default.target
