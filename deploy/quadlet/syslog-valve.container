[Unit]
Description=syslog-valve — visual syslog router/filter

[Container]
# Built locally with podman (see this dir's README); no registry is used.
Image=localhost/syslog-valve:latest
ContainerName=syslog-valve
Network=yard.network
# Prefix with 127.0.0.1: to publish on loopback only (single-host lab).
PublishPort=8081:8081
# Host entry into the valve's "External IN" block (add one in the UI and
# Apply); add pairs per extra listener. Internal traffic uses 514.
PublishPort=6514:6514/udp
PublishPort=6514:6514/tcp
Volume=valve-data.volume:/data
Environment=VALVE_ADDR=:8081
Environment=VALVE_DATA=/data
Environment=VALVE_SUGGESTED_FORWARD=bucket-syslog:514
Environment=YARD_LINK_HOSE=8080
Environment=YARD_LINK_VALVE=8081
Environment=YARD_LINK_BUCKET=8082
# Guard this UI with the bucket's user accounts (docs/AUTH.md); remove to run open.
Environment=YARD_AUTH_URL=http://syslog-bucket:8080
# External shares (see docs/SHARES.md): bind a host-mounted share and
# list its name so the UI offers it.
# Volume=/mnt/nas/syslog:/shares/archive:z
# Environment=YARD_SHARES=archive
# Stays root inside the container (syslog-ng binds the listeners you draw;
# existing valve-data volumes are root-owned) but keeps only what it uses:
# ports <1024, and writing/rotating/re-owning cache files on volumes and
# shares owned by another uid. See deploy/compose.yaml.
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=true
HealthCmd=wget -q -T 3 -O /dev/null http://127.0.0.1:8081/api/healthz
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
