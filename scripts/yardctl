#!/usr/bin/env bash
# yardctl — operate the syslog-yard suite on a Linux host.
#
#   yardctl prereqs    install a container runtime + compose (dnf or apt)
#   yardctl up         build images (pulling fresh base images) and start the suite
#   yardctl down       stop the suite (volumes are kept)
#   yardctl restart    restart all suite services
#   yardctl status     container status + UI health checks
#   yardctl logs [svc] follow logs (all services or one)
#   yardctl firewall   open the yard's ports (firewalld or ufw; needs sudo)
#   yardctl firewall-remove   close them again
#   yardctl service-install   start the suite at boot (systemd unit)
#   yardctl service-remove    stop starting at boot (suite keeps running)
#   yardctl smoke      send a test message through valve -> bucket
#   yardctl reset-admin   set a fresh random syslog-bucket admin password
#   yardctl bind-sso-accounts <issuer>   attach older SSO accounts to their provider
#
# UI ports: 8080 (hose) 8081 (valve) 8082 (bucket); syslog entry: 6514 udp+tcp.
# status, smoke and reset-admin also work for the podman quadlet units
# (deploy/quadlet); the other commands drive compose only.
set -euo pipefail

YARD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$YARD_DIR/deploy/compose.yaml"
UI_PORTS=(8080 8081 8082)
SYSLOG_PORT=6514

info() { printf '\e[1;34m[yardctl]\e[0m %s\n' "$*"; }
die()  { printf '\e[1;31m[yardctl]\e[0m %s\n' "$*" >&2; exit 1; }

# load_overlays reads YARD_COMPOSE_OVERLAYS (the environment, else
# deploy/.env, so the boot service sees it too): compose files to layer on
# the base one, separated by spaces or commas, relative to deploy/. The file
# is parsed rather than sourced because it also holds passwords.
load_overlays() {
    local setting="" word path words=()
    if [ -n "${YARD_COMPOSE_OVERLAYS+set}" ]; then
        setting=$YARD_COMPOSE_OVERLAYS
    elif [ -f "$YARD_DIR/deploy/.env" ]; then
        setting=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}YARD_COMPOSE_OVERLAYS=//p' "$YARD_DIR/deploy/.env" \
            | tail -n 1 | sed 's/[[:space:]]#.*$//' | tr -d "\"'\r")
    fi
    read -ra words <<<"${setting//,/ }"
    COMPOSE_ARGS=(-f "$COMPOSE_FILE")
    OVERLAY_FILES=()
    for word in ${words[@]+"${words[@]}"}; do
        case "$word" in
            /*) path=$word ;;
            *)  path=$YARD_DIR/deploy/$word ;;
        esac
        [ -f "$path" ] || die "YARD_COMPOSE_OVERLAYS: no such file: $path"
        COMPOSE_ARGS+=(-f "$path")
        OVERLAY_FILES+=("$path")
    done
}

compose() {
    load_overlays
    if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then
        docker compose "${COMPOSE_ARGS[@]}" "$@"
    elif command -v podman >/dev/null && podman compose version >/dev/null 2>&1; then
        podman compose "${COMPOSE_ARGS[@]}" "$@"
    elif command -v podman-compose >/dev/null; then
        podman-compose "${COMPOSE_ARGS[@]}" "$@"
    else
        die "no compose runtime found — run: yardctl prereqs"
    fi
}

# have_compose reports whether compose() has a provider to run.
have_compose() {
    { command -v docker >/dev/null && docker compose version >/dev/null 2>&1; } \
        || { command -v podman >/dev/null && podman compose version >/dev/null 2>&1; } \
        || { command -v podman-compose >/dev/null && command -v podman >/dev/null; }
}

# guard_host_net refuses to recreate a host-network valve from a file set
# without the host-network override: that would move it back onto the
# bridge, where its saved 127.0.0.1:5515 OUT no longer reaches the bucket.
guard_host_net() {
    load_overlays
    if [ "${#OVERLAY_FILES[@]}" -gt 0 ] \
        && grep -qsE '^[[:space:]]*network_mode:[[:space:]]*"?host' "${OVERLAY_FILES[@]}"; then
        return 0
    fi
    local engine=podman id
    if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then
        engine=docker
    fi
    command -v "$engine" >/dev/null || return 0
    id=$("$engine" ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME:-syslog-yard}" \
        --filter label=com.docker.compose.service=syslog-valve 2>/dev/null | head -n 1) || return 0
    [ -n "$id" ] || return 0
    [ "$("$engine" inspect --format '{{.HostConfig.NetworkMode}}' "$id" 2>/dev/null)" = host ] || return 0
    die "syslog-valve runs on the host network but the override is not loaded — add YARD_COMPOSE_OVERLAYS=compose.host-net.yaml to deploy/.env"
}

# quadlet reports whether the suite runs as podman quadlet units rather
# than under compose: quadlet names the containers after their units
# (compose prefixes the project name) and labels them with the unit.
quadlet() {
    command -v podman >/dev/null || return 1
    local unit
    unit=$(podman inspect --format '{{index .Config.Labels "PODMAN_SYSTEMD_UNIT"}}' syslog-bucket 2>/dev/null) || return 1
    [ "$unit" = syslog-bucket.service ]
}

# yard_exec runs a command inside one of the suite's containers, under
# compose or quadlet alike.
yard_exec() {
    local svc="$1"; shift
    if quadlet; then
        podman exec -i "$svc" "$@"
    else
        compose exec -T "$svc" "$@"
    fi
}

# up builds the images with fresh base images, refreshes the pulled
# images, and starts the suite. An offline host falls back to whatever
# base images are cached rather than failing.
up() {
    guard_host_net
    if ! compose build --pull; then
        info "could not pull fresh base images (offline?) — building from the local cache"
        compose build
    fi
    compose pull bucket-db bucket-syslog \
        || info "could not refresh postgres/syslog-ng images — using the local ones"
    compose up -d
    sync_bucket_conf
}

# sync_bucket_conf recreates bucket-syslog when its config differs from the
# checkout. bucket.conf is a single-file bind mount: git replaces the file on
# pull, the container keeps the old inode, and compose does not notice. Best
# effort: a check that cannot run warns and leaves the service alone. An
# overlay that mounts its own config owns it, so there is nothing to compare.
sync_bucket_conf() {
    local conf=$YARD_DIR/deploy/syslog-ng/bucket.conf want got
    load_overlays
    if [ "${#OVERLAY_FILES[@]}" -gt 0 ] \
        && grep -qsE '^[^#]*/etc/syslog-ng' "${OVERLAY_FILES[@]}"; then
        return 0
    fi
    want=$(sha256sum <"$conf" 2>/dev/null) || want=""
    want=${want%% *}
    got=$(compose exec -T bucket-syslog sha256sum /etc/syslog-ng/syslog-ng.conf </dev/null 2>/dev/null) || got=""
    got=$(printf '%s\n' "$got" | sed -n 's/^\([0-9a-f]\{64\}\)[[:space:]].*/\1/p' | head -n 1)
    if [ -z "$want" ] || [ -z "$got" ]; then
        info "warning: could not compare bucket-syslog's config — if bucket.conf changed, run: yardctl restart"
    elif [ "$want" != "$got" ]; then
        info "bucket.conf changed — recreating bucket-syslog"
        compose up -d --force-recreate --no-deps bucket-syslog \
            || info "warning: could not recreate bucket-syslog — it may still be on the old config"
    fi
}

prereqs() {
    if have_compose; then
        info "container runtime already present: $(command -v docker || command -v podman)"
    elif command -v podman >/dev/null; then
        # Checked before docker: podman-docker provides a `docker` shim.
        info "podman found without a compose provider — installing podman-compose"
        if command -v dnf >/dev/null; then
            sudo dnf install -y podman-compose
        elif command -v apt-get >/dev/null; then
            sudo apt-get update
            sudo apt-get install -y podman-compose
        else
            die "unsupported distro: install podman-compose manually"
        fi
    elif command -v docker >/dev/null; then
        info "docker found without the compose plugin — installing it"
        if command -v dnf >/dev/null; then
            sudo dnf install -y docker-compose-plugin || sudo dnf install -y docker-compose
        elif command -v apt-get >/dev/null; then
            sudo apt-get update
            sudo apt-get install -y docker-compose-v2 || sudo apt-get install -y docker-compose-plugin
        else
            die "unsupported distro: install the docker compose plugin manually"
        fi
    elif command -v dnf >/dev/null; then
        info "installing podman + podman-compose (dnf)"
        sudo dnf install -y podman podman-compose
    elif command -v apt-get >/dev/null; then
        info "installing docker + compose plugin (apt)"
        sudo apt-get update
        sudo apt-get install -y docker.io docker-compose-v2
        sudo systemctl enable --now docker
        info "add yourself to the docker group (or use sudo): sudo usermod -aG docker \$USER"
    else
        die "unsupported distro: install docker or podman manually"
    fi
    for tool in curl logger; do
        command -v "$tool" >/dev/null || info "note: '$tool' not found — needed for status/smoke"
    done
    have_compose || die "no working compose provider after install — install podman-compose or the docker compose plugin"
    info "prereqs OK"
}

firewall() {
    local action="$1" # add | remove
    if systemctl is-active --quiet firewalld 2>/dev/null; then
        local op="--add-port" && [ "$action" = remove ] && op="--remove-port"
        info "configuring firewalld ($action)"
        for p in "${UI_PORTS[@]}"; do sudo firewall-cmd --permanent "$op=$p/tcp"; done
        sudo firewall-cmd --permanent "$op=$SYSLOG_PORT/tcp"
        sudo firewall-cmd --permanent "$op=$SYSLOG_PORT/udp"
        sudo firewall-cmd --reload
        info "firewalld updated. If host->container UDP still fails, trust the"
        info "compose bridge interface:"
        info '  BR=br-$(docker network inspect syslog-yard_yardnet -f "{{.Id}}" | cut -c1-12)'
        info '  sudo firewall-cmd --permanent --zone=trusted --add-interface=$BR'
        info '  sudo firewall-cmd --reload'
    elif command -v ufw >/dev/null; then
        local cmd="allow" && [ "$action" = remove ] && cmd="delete allow"
        info "configuring ufw ($action)"
        for p in "${UI_PORTS[@]}"; do sudo ufw $cmd "$p/tcp"; done
        sudo ufw $cmd "$SYSLOG_PORT/tcp"
        sudo ufw $cmd "$SYSLOG_PORT/udp"
    else
        info "no firewalld/ufw detected — open these yourself if needed:"
        info "  tcp: ${UI_PORTS[*]} $SYSLOG_PORT   udp: $SYSLOG_PORT"
    fi
}

SERVICE=syslog-yard.service

# service_install makes the suite survive reboots: a oneshot systemd unit
# runs `compose up -d` at boot. Docker (and podman run as root) get a
# system unit; rootless podman gets a user unit plus lingering, since
# without a daemon its restart policies don't outlive a reboot.
service_install() {
    command -v systemctl >/dev/null || die "systemd not found"
    local docker_dep="" tmp
    if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then
        docker_dep=$'After=docker.service\nRequires=docker.service'
    fi
    tmp=$(mktemp)
    cat >"$tmp" <<EOF
[Unit]
Description=syslog-yard suite (hose / valve / bucket)
Wants=network-online.target
After=network-online.target
$docker_dep

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
ExecStart=$YARD_DIR/scripts/yardctl service-up
ExecStop=$YARD_DIR/scripts/yardctl down

[Install]
WantedBy=multi-user.target
EOF
    if [ -n "$docker_dep" ] || [ "$(id -u)" -eq 0 ]; then
        info "installing system unit /etc/systemd/system/$SERVICE"
        sudo install -m 0644 "$tmp" "/etc/systemd/system/$SERVICE"
        sudo systemctl daemon-reload
        sudo systemctl enable --now "$SERVICE"
        if [ -z "$docker_dep" ] && [ "$(id -u)" -eq 0 ]; then
            info "note: the unit runs podman as root — keep doing manual ops as"
            info "root too, or you'd be driving a second rootless instance"
        fi
    else
        info "installing user unit (~/.config/systemd/user/$SERVICE)"
        sed -i 's/^WantedBy=.*/WantedBy=default.target/' "$tmp"
        mkdir -p "$HOME/.config/systemd/user"
        install -m 0644 "$tmp" "$HOME/.config/systemd/user/$SERVICE"
        systemctl --user daemon-reload
        systemctl --user enable --now "$SERVICE"
        # Lingering lets the user unit start at boot, before any login.
        loginctl enable-linger "$USER" 2>/dev/null \
            || sudo loginctl enable-linger "$USER"
    fi
    rm -f "$tmp"
    info "service installed — the suite now starts at boot"
}

service_remove() {
    if [ -f "/etc/systemd/system/$SERVICE" ]; then
        sudo systemctl disable "$SERVICE" || true
        sudo rm "/etc/systemd/system/$SERVICE"
        sudo systemctl daemon-reload
    elif [ -f "$HOME/.config/systemd/user/$SERVICE" ]; then
        systemctl --user disable "$SERVICE" || true
        rm "$HOME/.config/systemd/user/$SERVICE"
        systemctl --user daemon-reload
    else
        info "no $SERVICE installed"
        return
    fi
    info "boot service removed (suite untouched; 'yardctl down' stops it)"
}

status() {
    if quadlet; then
        podman ps --all --filter label=PODMAN_SYSTEMD_UNIT \
            --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    else
        compose ps
    fi
    echo
    for p in "${UI_PORTS[@]}"; do
        if curl -fsS -m 2 -o /dev/null "http://localhost:$p/"; then
            info "UI :$p up"
        else
            info "UI :$p NOT responding"
        fi
    done
}

# bucket_stored reports whether a message containing needle has landed in
# the bucket's store. It queries Postgres directly rather than the REST API:
# /api/entries needs a session (auth required), and the datastore is the
# most direct "did it actually get stored" check anyway. Needs the suite up.
bucket_stored() {
    local needle="$1" n
    n=$(yard_exec bucket-db psql -U syslog_bucket -tAc \
        "select count(*) from entries where msg like '%${needle}%'" 2>/dev/null | tr -d '[:space:]')
    [ "${n:-0}" -gt 0 ] 2>/dev/null
}

smoke() {
    # user.err: severe enough that the demo flow's severity filter forwards
    # it to the bucket instead of caching it as noise. Probe both transports:
    # VM-based runtimes (Rancher/Docker Desktop, Colima) forward TCP but not
    # UDP, so one missing transport is a warning, not a failure.
    local ts ok=""
    ts=$(date +%s)
    info "sending test messages to localhost:$SYSLOG_PORT (udp + tcp)"
    logger -n 127.0.0.1 -P "$SYSLOG_PORT" -d -p user.err --rfc3164 -t yard-udp "yardctl smoke udp $ts" || true
    logger -n 127.0.0.1 -P "$SYSLOG_PORT" -T -p user.err --rfc3164 -t yard-tcp "yardctl smoke tcp $ts" || true
    sleep 2
    for proto in udp tcp; do
        if bucket_stored "smoke $proto $ts"; then
            info "smoke $proto OK — reached syslog-bucket"
            ok=1
        else
            info "smoke $proto: message did not arrive (needs an applied, enabled External IN block on the valve; UDP cannot cross VM-based runtimes' port forwarding)"
        fi
    done
    [ -n "$ok" ] || die "smoke FAILED — nothing reached syslog-bucket (valve flow applied? firewall? see yardctl firewall)"
}

reset_admin() {
    # Generate a fresh random admin password (the bucket prints it). Useful
    # on a forgotten password or to rotate the generated one. Runs inside
    # the live container so it reuses its database connection.
    info "resetting the syslog-bucket admin password"
    yard_exec syslog-bucket syslog-bucket reset-admin \
        || die "could not reach the syslog-bucket container — is the suite up? (yardctl up)"
    info "other admin sessions were signed out; sign in at http://localhost:8082"
}

bind_sso_accounts() {
    [ -n "${1:-}" ] || die "usage: yardctl bind-sso-accounts <issuer-url>"
    yard_exec syslog-bucket syslog-bucket bind-sso-accounts "$1" \
        || die "could not bind the accounts — is the suite up? (yardctl up)"
}

case "${1:-}" in
    prereqs)          prereqs ;;
    up|start)         up && status ;;
    down|stop)        compose down ;;
    restart)          compose restart && status ;;
    status)           status ;;
    logs)             shift; compose logs -f "$@" ;;
    firewall)         firewall add ;;
    firewall-remove)  firewall remove ;;
    service-install)  service_install ;;
    service-remove)   service_remove ;;
    service-up)       guard_host_net; compose up -d ;; # systemd ExecStart hook (no build/curl)
    smoke)            smoke ;;
    reset-admin)      reset_admin ;;
    bind-sso-accounts) shift; bind_sso_accounts "$@" ;;
    *)                grep '^#   yardctl' "$0" | sed 's/^# *//'; exit 1 ;;
esac
